{
  "name": "@shalcon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/phase1-d1-test",
    "db:migrate:phase2:local": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/phase2-d1-test",
    "db:migrate:phase4:local": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/phase4-d1-test",
    "test:d1:worker": "wrangler dev src/phase1.integration.ts --local --port 8790 --persist-to ../../.wrangler/phase1-d1-test",
    "test:d1:phase2-worker": "wrangler dev src/phase2.integration.ts --local --port 8791 --persist-to ../../.wrangler/phase2-d1-test",
    "test:d1:phase4-worker": "wrangler dev src/phase4.integration.ts --local --port 8792 --persist-to ../../.wrangler/phase4-d1-test"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
